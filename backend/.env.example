DATABASE_URL=postgresql+asyncpg://agrimind:agrimind_dev_password@localhost:5432/agrimind
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Điền API key thật ở đây, KHÔNG commit file .env vào git
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Current champion model names. Changing one requires offline eval/canary first.
MODEL_PLANNER=gemini-3.1-flash-lite
MODEL_REFLECTION=gemini-3.1-flash-lite
MODEL_GENERATION=gemini-3.5-flash
MODEL_MEMORY=gemini-3.1-flash-lite
MODEL_REQUEST_TIMEOUT_SECONDS=45
AI_POLICY_VERSION=safety-v2
PROMPT_BUNDLE_VERSION=prompts-v2
EVIDENCE_SCHEMA_VERSION=evidence-v2
KNOWLEDGE_BASE_VERSION=kb-v1
RERANK_MIN_CONFIDENCE=0.10
RETRIEVAL_EXCLUDED_SOURCES=test,mock_source
RRF_DENSE_WEIGHT=1.0
RRF_SPARSE_WEIGHT=1.15
MCP_WEATHER_URL=http://localhost:8002/mcp
MCP_REQUEST_TIMEOUT_SECONDS=10
MAX_CHAT_IMAGE_BYTES=4194304
MAX_CHAT_IMAGE_PIXELS=16000000
MIN_CHAT_IMAGE_DIMENSION=256
VISION_ANALYSIS_ENABLED=false
VISION_REQUEST_TIMEOUT_SECONDS=30
VISION_OBSERVATION_SCHEMA_VERSION=visual-observation-v1

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Paid Google Search grounding is off for the free-tier deployment. Enable it
# together with the Flutter dart-define only after approving provider cost.
DEEP_RESEARCH_ENABLED=false
DEEP_RESEARCH_MODEL=gemini-3.5-flash
DEEP_RESEARCH_MAX_SOURCES=6

# Evaluation credentials are local/CI secrets. Never commit real values.
EVAL_USER_EMAIL=
EVAL_USER_PASSWORD=
EVAL_API_URL=http://localhost:8000/api/v1/chat/stream
EVAL_DATASET_VERSION=v1
